{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Audcomp Design System",
  "description": "Design tokens for audcomp.com. Mirrors app/globals.css. Navy + white + teal.",
  "color": {
    "brand": {
      "navy": { "value": "#071e3d", "comment": "Darkest brand background: nav, hero, dark sections" },
      "navy-mid": { "value": "#0d2d55", "comment": "Gradient midpoint on dark sections" },
      "primary": { "value": "#0071e3", "comment": "Primary action color" },
      "primary-hover": { "value": "#0077ed", "comment": "Primary hover" },
      "teal": { "value": "#06b6d4", "comment": "Eyebrow labels, AI accent" },
      "sky": { "value": "#38bdf8", "comment": "Links/arrows on dark surfaces" },
      "black": { "value": "#000000", "comment": "Footer background" }
    },
    "semantic": {
      "background": { "value": "#ffffff" },
      "foreground": { "value": "#0a2540", "comment": "Primary text on light" },
      "card": { "value": "#ffffff" },
      "card-foreground": { "value": "#0a2540" },
      "muted": { "value": "#f0f7ff", "comment": "Section tints, secondary surfaces" },
      "muted-foreground": { "value": "#4a6785", "comment": "Secondary text" },
      "accent": { "value": "#e0f2fe" },
      "accent-foreground": { "value": "#0a2540" },
      "border": { "value": "#dde8f5", "comment": "Hairline borders on light" },
      "input": { "value": "#dde8f5" },
      "ring": { "value": "#0071e3" },
      "destructive": { "value": "#ef4444" },
      "destructive-foreground": { "value": "#ffffff" }
    },
    "chart": {
      "chart-1": { "value": "#0071e3" },
      "chart-2": { "value": "#06b6d4" },
      "chart-3": { "value": "#0ea5e9" },
      "chart-4": { "value": "#38bdf8" },
      "chart-5": { "value": "#0284c7" }
    },
    "dark-surface": {
      "glass-fill": { "value": "rgba(255,255,255,0.06)", "comment": "Glass card fill on dark" },
      "glass-border": { "value": "rgba(255,255,255,0.10)", "comment": "Glass card border on dark" },
      "text-primary": { "value": "#ffffff" },
      "text-secondary": { "value": "rgba(255,255,255,0.55)" },
      "text-tertiary": { "value": "rgba(255,255,255,0.35)" }
    }
  },
  "font": {
    "family": {
      "sans": { "value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif" },
      "heading": { "value": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "value": "'SF Mono', 'JetBrains Mono', monospace" },
      "serif": { "value": "'Source Serif 4', serif" }
    },
    "weight": {
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" },
      "black": { "value": "900", "comment": "Agent Studio surface only" }
    },
    "tracking": {
      "heading": { "value": "-0.02em", "comment": "Applied to h1-h6" },
      "widest": { "value": "0.1em", "comment": "Eyebrow labels" },
      "studio": { "value": "0.3em", "comment": "Agent Studio uppercase labels" }
    }
  },
  "radius": {
    "base": { "value": "1rem", "comment": "--radius" },
    "card": { "value": "1rem", "comment": "rounded-2xl" },
    "pill": { "value": "9999px", "comment": "rounded-full buttons" },
    "studio": { "value": "2rem", "comment": "Agent Studio cards" },
    "studio-lg": { "value": "3rem", "comment": "Agent Studio featured card" }
  },
  "shadow": {
    "sm": { "value": "0 1px 2px 0 rgba(10,37,64,0.05)" },
    "card-hover": { "value": "0 10px 30px -10px rgba(10,37,64,0.15)" },
    "glow-blue": { "value": "0 20px 60px -15px rgba(0,113,227,0.30)" }
  },
  "gradient": {
    "dark-section": { "value": "linear-gradient(135deg, #071e3d 0%, #0d2d55 50%, #071e3d 100%)" },
    "text-dark": { "value": "linear-gradient(180deg, #ffffff 0%, #a8c8e8 100%)" },
    "text-studio": { "value": "linear-gradient(135deg, #ffffff 0%, #06b6d4 60%, #0071e3 100%)" }
  }
}
