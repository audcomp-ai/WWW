    "duplexify": "^4.1.3",
    "end-of-stream": "^1.4.5",
    "fastify-plugin": "^5.1.0",
    "inherits": "^2.0.4",
    "once": "^1.4.0",
    "readable-stream": "^3.6.2",
    "safe-buffer": "^5.2.1",
    "stream-shift": "^1.0.3",
